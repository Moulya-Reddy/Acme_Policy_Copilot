# Which provider to use: "ollama" (default, real Llama, free forever, local)
# or "groq" (hosted, free tier, currently openai/gpt-oss-120b - Groq has no
# Llama chat model left as of Aug 2026, see README).
LLM_PROVIDER=ollama

# Only needed if LLM_PROVIDER=groq. Free at https://console.groq.com — no credit card required.
GROQ_API_KEY=your_groq_api_key_here
